{
  "name": "canva-formation-formulaire",
  "private": true,
  "version": "1.0.0",
  "description": "Site statique Formation Canva Pro — CSS Tailwind compilé",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i tailwind.src.css -o tailwind.css --minify",
    "build:fonts": "node scripts/fetch-fonts.js",
    "build:fiches": "node scripts/build-fiches.js",
    "watch:css": "tailwindcss -c tailwind.config.js -i tailwind.src.css -o tailwind.css --watch",
    "serve": "serve -l 5173 ."
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "serve": "^14.2.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17"
  }
}
