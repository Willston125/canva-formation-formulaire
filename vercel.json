{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "api/_lib/**",
      "maxDuration": 10
    },
    "api/quotidien.js": {
      "includeFiles": "api/_lib/**",
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/quotidien", "schedule": "0 3 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:chemin(.*)",
      "has": [{ "type": "host", "value": "canva-formation-formulaire.vercel.app" }],
      "destination": "https://cineworldacademie.com/:chemin",
      "permanent": true
    },
    {
      "source": "/:chemin(.*)",
      "has": [{ "type": "host", "value": "www.cineworldacademie.com" }],
      "destination": "https://cineworldacademie.com/:chemin",
      "permanent": true
    },
    { "source": "/formations", "destination": "/#catalogue", "permanent": true },
    { "source": "/formations/", "destination": "/#catalogue", "permanent": true },
    { "source": "/formations/1", "destination": "/formations/ia-appliquee/", "permanent": true },
    { "source": "/formations/2", "destination": "/formations/identite-visuelle/", "permanent": true },
    { "source": "/formations/3", "destination": "/formations/photo-video/", "permanent": true },
    { "source": "/formations/4", "destination": "/formations/marketing-digital/", "permanent": true },
    { "source": "/production/:projet(.+)", "destination": "/production/", "permanent": true },
    { "source": "/a-propos", "destination": "/association/", "permanent": true },
    { "source": "/maintenance", "destination": "/", "permanent": true }
  ]
}
