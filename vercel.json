{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "api/_lib/**",
      "maxDuration": 10
    },
    "api/quotidien.js": {
      "includeFiles": "api/_lib/**",
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/quotidien", "schedule": "0 3 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self), payment=(), usb=()" }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/assets/brand/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://isxkyikakrssekrxudjw.supabase.co; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:chemin(.*)",
      "has": [{ "type": "host", "value": "canva-formation-formulaire.vercel.app" }],
      "destination": "https://cineworldacademie.com/:chemin",
      "permanent": true
    },
    {
      "source": "/:chemin(.*)",
      "has": [{ "type": "host", "value": "www.cineworldacademie.com" }],
      "destination": "https://cineworldacademie.com/:chemin",
      "permanent": true
    },
    {
      "source": "/:chemin(.*)",
      "has": [{ "type": "host", "value": "www.impactali.site" }],
      "destination": "https://cineworldacademie.com/:chemin",
      "permanent": true
    },
    {
      "source": "/:chemin(.*)",
      "has": [{ "type": "host", "value": "impactali.site" }],
      "destination": "https://cineworldacademie.com/:chemin",
      "permanent": true
    },
    { "source": "/formations", "destination": "/#catalogue", "permanent": true },
    { "source": "/formations/", "destination": "/#catalogue", "permanent": true },
    { "source": "/formations/1", "destination": "/formations/ia-appliquee/", "permanent": true },
    { "source": "/formations/2", "destination": "/formations/identite-visuelle/", "permanent": true },
    { "source": "/formations/3", "destination": "/formations/photo-video/", "permanent": true },
    { "source": "/formations/4", "destination": "/formations/marketing-digital/", "permanent": true },
    { "source": "/production/:projet(.+)", "destination": "/production/", "permanent": true },
    { "source": "/a-propos", "destination": "/association/", "permanent": true },
    { "source": "/maintenance", "destination": "/", "permanent": true }
  ]
}
